% The export script passes --syntax-highlighting=none, so this template defines no highlighting macros.
% A template used with pandoc's default highlighting must define them (pandoc's default template shows how).
% Minimal pandoc LaTeX template: the pattern for feeding pandoc's body into a company class.
% To use a company class, replace `article` below with the class name and set the class's cover
% and revision macros where marked. The class files come from the `latexTemplate` setting,
% which the export script unpacks next to the build, so \documentclass finds them.
\documentclass[11pt,a4paper]{article} % <- your company class goes here
\usepackage[T1]{fontenc}
\usepackage{lmodern}
\usepackage[a4paper,margin=2.5cm]{geometry}
\usepackage{graphicx,xcolor,calc,etoolbox,booktabs,longtable,array}
\usepackage{hyperref}
\usepackage{fvextra}

% Macros that pandoc's LaTeX output expects (from pandoc's default template).
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\newcounter{none} % pandoc sets \LTcaptype{none} on tables without a caption
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi
}
\makeatother

% Code in Latin Modern Mono, an outline font with a Unicode map; the default fallback is a bitmap font
% whose text many PDF viewers cannot search.
\renewcommand*\ttdefault{lmtt}
\RecustomVerbatimEnvironment{verbatim}{Verbatim}{breaklines,breakanywhere,fontsize=\small}
\AtBeginEnvironment{longtable}{\small}
\sloppy
% No hyphenation: a word split across lines keeps its hyphen in the PDF text, so Ctrl+F misses it.
\hyphenpenalty=10000
\exhyphenpenalty=10000
\setcounter{secnumdepth}{2}
$if(hidelinks)$\hypersetup{hidelinks}$else$\hypersetup{colorlinks,linkcolor=blue!60!black,urlcolor=blue!60!black}$endif$

\begin{document}

% Cover page. With a company class, call its cover macro here instead.
\begin{titlepage}
\raggedright
\vspace*{4cm}
{\Huge\bfseries $title$\par}
\vspace{0.5cm}
{\Large $subtitle$\par}
\vspace{1.5cm}
$if(client)$Client: $client$\par$endif$
$for(author)$$author$$sep$, $endfor$\par
$date$\par
\vfill
\begin{tabular}{@{}ll@{}}
Revision & $revision$ \tabularnewline
Note & $revision-note$ \tabularnewline
Classification & $classification$ \tabularnewline
\end{tabular}
\end{titlepage}

% Revision table: with a company class, call its revision macros here.
$if(revisions)$
\begin{tabular}{@{}lll@{}}
$for(revisions)$$revisions.rev$ & $revisions.note$ & $revisions.date$ \tabularnewline
$endfor$\end{tabular}
\newpage
$endif$

\tableofcontents
\newpage

% Documentation mixes short paragraphs and lists; spacing reads better than indents.
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5\baselineskip}

$body$

\end{document}
